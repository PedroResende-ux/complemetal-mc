{
  "schemaVersion": 1,
  "id": "metalrender",
  "version": "${version}",
  "license": "Apache-2.0",
  "authors": [
    "pebbles_boon"
  ],
  "name": "MetalRender",
  "description": "Experimental Apple Silicon Metal renderer with a safe Minecraft fallback",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.pebbles_boon.metalrender.MetalRenderClient"
    ]
  },
  "mixins": [
    "metalrender.mixins.json",
    "metalrender.iris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": ">=0.156.0",
    "java": ">=25"
  }
}
