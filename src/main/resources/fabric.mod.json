{
  "schemaVersion": 1,
  "id": "complemetal",
  "version": "${version}",
  "license": "Apache-2.0",
  "authors": [
    "daniiarkg",
    "pebbles_boon (original MetalRender)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/complemetal",
    "sources": "https://github.com/daniiarkg/complemetal-mc",
    "issues": "https://github.com/daniiarkg/complemetal-mc/issues"
  },
  "name": "Complemetal",
  "description": "Apple Silicon Metal 4 renderer for Iris shaders with a strict fail-open OpenGL fallback",
  "icon": "assets/complemetal/icon.png",
  "provides": [
    "metalrender"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.pebbles_boon.metalrender.MetalRenderClient"
    ]
  },
  "mixins": [
    "metalrender.mixins.json",
    "metalrender.iris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": ">=0.156.0",
    "java": ">=25"
  }
}
